<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net48;net8.0-windows</TargetFrameworks>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <SkipPyRevitDeploy>true</SkipPyRevitDeploy>
    <TestTfmsInParallel>false</TestTfmsInParallel>
    <UseRevit>false</UseRevit>
    <UseIronPython>false</UseIronPython>
    <NoWarn>$(NoWarn);NUnit2005;NUnit2006;NUnit1033;NUnit2048;NUnit2049</NoWarn>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\pyRevitExtensionParser\pyRevitExtensionParser.csproj" AdditionalProperties="SkipPyRevitDeploy=true" />
    <ProjectReference Include="..\..\..\pyRevitLabs\pyRevitLabs.Configurations\pyRevitLabs.Configurations.csproj" AdditionalProperties="SkipPyRevitDeploy=true" />
    <ProjectReference Include="..\..\..\pyRevitLabs\pyRevitLabs.Configurations.Ini\pyRevitLabs.Configurations.Ini.csproj" AdditionalProperties="SkipPyRevitDeploy=true" />
    <ProjectReference Include="..\..\..\pyRevitLabs\pyRevitLabs.pyRevit\pyRevitLabs.PyRevit.csproj" AdditionalProperties="SkipPyRevitDeploy=true" />
  </ItemGroup>
  <ItemGroup>
    <Compile Include="..\TestSupport\*.cs" Link="TestSupport\%(Filename)%(Extension)" />
  </ItemGroup>
  <ItemGroup>
    <Compile Remove="Samples\**\*.cs" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.0" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.3.0" />
    <PackageReference Include="NUnit" Version="4.5.1" />
    <PackageReference Include="NUnit.Analyzers" Version="4.12.0" />
    <PackageReference Include="NUnit3TestAdapter" Version="6.2.0" />
    <PackageReference Include="System.Drawing.Common" Version="10.0.5" />
  </ItemGroup>
  <ItemGroup Condition="'$(TargetFramework)' == 'net48'">
    <Reference Include="pyRevitLabs.NLog" HintPath="..\..\..\libs\netfx\pyRevitLabs.NLog.dll" Private="true" />
    <Reference Include="pyRevitLabs.Json" HintPath="..\..\..\libs\netfx\pyRevitLabs.Json.dll" Private="true" />
  </ItemGroup>
  <ItemGroup Condition="'$(TargetFramework)' == 'net8.0-windows'">
    <Reference Include="pyRevitLabs.NLog" HintPath="..\..\..\libs\netcore\pyRevitLabs.NLog.dll" Private="true" />
    <Reference Include="pyRevitLabs.Json" HintPath="..\..\..\libs\netcore\pyRevitLabs.Json.dll" Private="true" />
  </ItemGroup>
  <ItemGroup>
    <Compile Include="..\..\..\tests\TestSupport\RepositoryPaths.cs" Link="TestSupport\RepositoryPaths.cs" />
    <Using Include="NUnit.Framework" />
    <Using Include="NUnit.Framework.Legacy" />
  </ItemGroup>
</Project>
