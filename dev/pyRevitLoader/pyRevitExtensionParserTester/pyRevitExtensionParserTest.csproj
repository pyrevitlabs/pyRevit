<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
	<DisableImplicitProps>true</DisableImplicitProps>
	<DisableImplicitTargets>true</DisableImplicitTargets>
	<IronPythonVersion>IPY342</IronPythonVersion>
	<Version>3.4.2</Version>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <EnableDefaultCompileItems>true</EnableDefaultCompileItems>
	<UseLoader>false</UseLoader>
	<UseIronPython>false</UseIronPython>
    <UseRevit>false</UseRevit>
    <UseAssemblyBuilder>true</UseAssemblyBuilder>
    <UseExtensionParser>true</UseExtensionParser>
    <LangVersion>latest</LangVersion>
    <TestTfmsInParallel>false</TestTfmsInParallel>
    <SkipPyRevitDeploy>true</SkipPyRevitDeploy>
    <RunSettingsFilePath>test.runsettings</RunSettingsFilePath>
	<!-- Suppress NUnit analyzer suggestions for classic assertion model and related style hints -->
	<NoWarn>$(NoWarn);NUnit2005;NUnit2006;NUnit1033;NUnit2048;NUnit2049</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="RuntimeTest.cs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\pyRevitLabs\pyRevitLabs.Configurations\pyRevitLabs.Configurations.csproj" />
    <ProjectReference Include="..\..\pyRevitLabs\pyRevitLabs.Configurations.Ini\pyRevitLabs.Configurations.Ini.csproj" />
    <ProjectReference Include="..\..\pyRevitLabs\pyRevitLabs.PyRevit\pyRevitLabs.PyRevit.csproj" />
    <ProjectReference Include="..\..\pyRevitLabs\pyRevitLabs.Emojis\pyRevitLabs.Emojis.csproj" />
    <ProjectReference Condition="'$(TargetFramework)' == 'net48'" Include="..\..\pyRevitLabs.PyRevit.Runtime\2024\pyRevitLabs.PyRevit.Runtime.2024.csproj" AdditionalProperties="Configuration=Debug IPY342" />
    <ProjectReference Condition="'$(TargetFramework)' == 'net8.0-windows'" Include="..\..\pyRevitLabs.PyRevit.Runtime\2026\pyRevitLabs.PyRevit.Runtime.2026.csproj" AdditionalProperties="Configuration=Debug IPY342" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.0" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.3.0" />
    <PackageReference Include="NUnit" Version="4.5.1" />
    <PackageReference Include="NUnit.Analyzers" Version="4.12.0" />
    <PackageReference Include="NUnit3TestAdapter" Version="6.2.0" />
    <PackageReference Include="System.Drawing.Common" Version="10.0.5" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net48'">
    <Reference Include="pyRevitLabs.NLog">
      <HintPath>..\..\libs\netfx\pyRevitLabs.NLog.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <Reference Include="pyRevitLabs.Json">
      <HintPath>..\..\libs\netfx\pyRevitLabs.Json.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <!-- ScriptIO holds a ScriptConsole reference, so instantiating one needs the
         MahApps types that type drags in. The Runtime project marks this
         reference copy-local=false; the tests have to bring it along. -->
    <Reference Include="pyRevitLabs.MahAppsMetro">
      <HintPath>..\..\libs\netfx\pyRevitLabs.MahAppsMetro.dll</HintPath>
      <Private>true</Private>
    </Reference>
  </ItemGroup>
  <ItemGroup Condition="'$(TargetFramework)' == 'net8.0-windows'">
    <Reference Include="pyRevitLabs.NLog">
      <HintPath>..\..\libs\netcore\pyRevitLabs.NLog.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <Reference Include="pyRevitLabs.Json">
      <HintPath>..\..\libs\netcore\pyRevitLabs.Json.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <!-- ScriptIO holds a ScriptConsole reference, so instantiating one needs the
         MahApps types that type drags in. The Runtime project marks this
         reference copy-local=false; the tests have to bring it along. -->
    <Reference Include="pyRevitLabs.MahAppsMetro">
      <HintPath>..\..\libs\netcore\pyRevitLabs.MahAppsMetro.dll</HintPath>
      <Private>true</Private>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <Using Include="NUnit.Framework" />
    <Using Include="NUnit.Framework.Legacy" />
  </ItemGroup>

</Project>
