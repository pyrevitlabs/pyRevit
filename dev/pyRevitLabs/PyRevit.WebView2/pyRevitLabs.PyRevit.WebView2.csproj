<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <UseWpf>true</UseWpf>

        <Platforms>x64</Platforms>
        <TargetFrameworks>net48;net8.0-windows</TargetFrameworks>

        <AssemblyName>pyRevitLabs.PyRevit.WebView2</AssemblyName>
        <RootNamespace>PyRevitLabs.PyRevit.WebView2</RootNamespace>
    </PropertyGroup>

    <!--
      The package is referenced for its files only. Its own targets would pick
      the net5.0 WPF build for net8.0, while pyRevit ships the netcoreapp3.0
      build on every .NET target: the same set the isolation fix was verified
      against, and the one the isolated deployment copies.
    -->
    <ItemGroup>
        <PackageReference Include="Microsoft.Web.WebView2" Version="$(PyRevitWebView2Version)"
                          GeneratePathProperty="true" ExcludeAssets="all" PrivateAssets="all" />
    </ItemGroup>

    <ItemGroup Condition="'$(TargetFrameworkIdentifier)' == '.NETFramework'">
        <Reference Include="Microsoft.Web.WebView2.Core" HintPath="$(PkgMicrosoft_Web_WebView2)\lib\net462\Microsoft.Web.WebView2.Core.dll" Private="false" />
        <Reference Include="Microsoft.Web.WebView2.WinForms" HintPath="$(PkgMicrosoft_Web_WebView2)\lib\net462\Microsoft.Web.WebView2.WinForms.dll" Private="false" />
        <Reference Include="Microsoft.Web.WebView2.Wpf" HintPath="$(PkgMicrosoft_Web_WebView2)\lib\net462\Microsoft.Web.WebView2.Wpf.dll" Private="false" />
    </ItemGroup>

    <ItemGroup Condition="'$(TargetFrameworkIdentifier)' != '.NETFramework'">
        <Reference Include="Microsoft.Web.WebView2.Core" HintPath="$(PkgMicrosoft_Web_WebView2)\lib_manual\netcoreapp3.0\Microsoft.Web.WebView2.Core.dll" Private="false" />
        <Reference Include="Microsoft.Web.WebView2.WinForms" HintPath="$(PkgMicrosoft_Web_WebView2)\lib_manual\netcoreapp3.0\Microsoft.Web.WebView2.WinForms.dll" Private="false" />
        <Reference Include="Microsoft.Web.WebView2.Wpf" HintPath="$(PkgMicrosoft_Web_WebView2)\lib_manual\netcoreapp3.0\Microsoft.Web.WebView2.Wpf.dll" Private="false" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\PyRevit.Renderer\pyRevitLabs.PyRevit.Renderer.csproj" Private="false" />
    </ItemGroup>
</Project>
