<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <UseWpf>true</UseWpf>

        <Platforms>x64</Platforms>
        <TargetFrameworks>net48;net8.0-windows</TargetFrameworks>

        <AssemblyName>pyRevitLabs.PyRevit.WebView2</AssemblyName>
        <RootNamespace>PyRevitLabs.PyRevit.WebView2</RootNamespace>
    </PropertyGroup>

    <ItemGroup>
        <Reference Include="Microsoft.Web.WebView2.Core" HintPath="$(PyRevitDevLibsDir)\Microsoft.Web.WebView2.Core.dll" Private="false" />
        <Reference Include="Microsoft.Web.WebView2.WinForms" HintPath="$(PyRevitDevLibsDir)\Microsoft.Web.WebView2.WinForms.dll" Private="false" />
        <Reference Include="Microsoft.Web.WebView2.Wpf" HintPath="$(PyRevitDevLibsDir)\Microsoft.Web.WebView2.Wpf.dll" Private="false" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\PyRevit.Renderer\pyRevitLabs.PyRevit.Renderer.csproj" Private="false" />
    </ItemGroup>
</Project>
