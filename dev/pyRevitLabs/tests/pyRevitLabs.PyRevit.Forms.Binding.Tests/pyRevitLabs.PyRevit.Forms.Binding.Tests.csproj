<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <TargetFrameworks>net48;net8.0-windows;net10.0-windows</TargetFrameworks>
        <LangVersion>latest</LangVersion>
        <UseWPF>true</UseWPF>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <IsPackable>false</IsPackable>
        <IsTestProject>true</IsTestProject>
        <PermitDeploy>true</PermitDeploy>
        <NoWarn>$(NoWarn);CS0612</NoWarn>
    </PropertyGroup>
    <ItemGroup>
        <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.8.0"/>
        <PackageReference Include="xunit" Version="2.5.3"/>
        <PackageReference Include="xunit.runner.visualstudio" Version="2.5.3"/>
        <Reference Include="pyRevitLabs.PythonNet"
                   HintPath="$(PyRevitDevLibsDir)\pyRevitLabs.PythonNet.dll"
                   Private="true"/>
    </ItemGroup>
    <ItemGroup>
        <ProjectReference Include="..\..\pyRevitLabs.PyRevit.Forms.Binding\pyRevitLabs.PyRevit.Forms.Binding.csproj"/>
    </ItemGroup>
    <ItemGroup>
        <Content Include="..\..\..\..\release\cengines\CPY3123\**\*"
                 LinkBase="CPY3123" CopyToOutputDirectory="PreserveNewest"/>
    </ItemGroup>
</Project>
