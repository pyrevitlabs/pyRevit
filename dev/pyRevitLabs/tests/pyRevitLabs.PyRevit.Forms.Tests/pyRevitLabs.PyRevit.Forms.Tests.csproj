<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <TargetFrameworks>net48;net8.0-windows;net10.0-windows</TargetFrameworks>
        <LangVersion>latest</LangVersion>
        <UseWPF>true</UseWPF>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <IsPackable>false</IsPackable>
        <IsTestProject>true</IsTestProject>
        <PermitDeploy>true</PermitDeploy>
    </PropertyGroup>
    <ItemGroup>
        <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.8.0"/>
        <PackageReference Include="xunit" Version="2.5.3"/>
        <PackageReference Include="xunit.runner.visualstudio" Version="2.5.3"/>
        <Reference Include="pyRevitLabs.PythonNet"
                   HintPath="$(PyRevitDevLibsDir)\pyRevitLabs.PythonNet.dll"
                   Private="true"/>
    </ItemGroup>
    <ItemGroup>
        <Content Include="..\..\..\..\release\cengines\CPY3123\**\*"
                 LinkBase="CPY3123" CopyToOutputDirectory="PreserveNewest"/>
        <Content Include="..\..\..\..\pyrevitlib\pyrevit\forms\**\*"
                 Exclude="..\..\..\..\pyrevitlib\pyrevit\forms\**\__pycache__\**"
                 LinkBase="forms" CopyToOutputDirectory="PreserveNewest"/>
        <None Update="FormsProbe.py" CopyToOutputDirectory="PreserveNewest"/>
        <None Update="BindingProbe.py" CopyToOutputDirectory="PreserveNewest"/>
        <None Update="SelectionProbe.py" CopyToOutputDirectory="PreserveNewest"/>
        <Content Include="PanelProbe.xaml" CopyToOutputDirectory="PreserveNewest"/>
        <Content Include="..\..\..\..\pyrevitlib\pyrevit\unittests\test_forms_parity.py"
                 Link="test_forms_parity.py" CopyToOutputDirectory="PreserveNewest"/>
        <Content Include="..\..\..\..\pyrevitlib\pyrevit\coreutils\colors.py" Link="colors.py" CopyToOutputDirectory="PreserveNewest"/>
    </ItemGroup>
</Project>
