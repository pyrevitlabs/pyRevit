<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net48;net8.0-windows</TargetFrameworks>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <SkipPyRevitDeploy>true</SkipPyRevitDeploy>
    <TestTfmsInParallel>false</TestTfmsInParallel>
    <UseRevit>false</UseRevit>
    <UseIronPython>false</UseIronPython>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.0" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.3.0" />
    <PackageReference Include="MSTest.TestAdapter" Version="3.1.1" />
    <PackageReference Include="MSTest.TestFramework" Version="3.1.1" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\pyRevitLabs.TargetApps.Revit\pyRevitLabs.TargetApps.Revit.csproj" AdditionalProperties="SkipPyRevitDeploy=true" />
  </ItemGroup>
  <ItemGroup Condition="'$(TargetFramework)' == 'net48'">
    <Reference Include="pyRevitLabs.NLog" HintPath="..\..\..\libs\netfx\pyRevitLabs.NLog.dll" Private="true" />
    <Reference Include="pyRevitLabs.Json" HintPath="..\..\..\libs\netfx\pyRevitLabs.Json.dll" Private="true" />
  </ItemGroup>
  <ItemGroup Condition="'$(TargetFramework)' == 'net8.0-windows'">
    <Reference Include="pyRevitLabs.NLog" HintPath="..\..\..\libs\netcore\pyRevitLabs.NLog.dll" Private="true" />
    <Reference Include="pyRevitLabs.Json" HintPath="..\..\..\libs\netcore\pyRevitLabs.Json.dll" Private="true" />
  </ItemGroup>
</Project>
