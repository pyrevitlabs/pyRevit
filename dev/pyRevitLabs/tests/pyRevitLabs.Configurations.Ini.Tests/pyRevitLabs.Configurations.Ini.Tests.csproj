<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net8.0-windows</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>

        <IsPackable>false</IsPackable>
        <IsTestProject>true</IsTestProject>

        <!-- Keep test assemblies out of the product bin, which is signed and
             shipped wholesale by the installer. -->
        <PermitDeploy>true</PermitDeploy>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="coverlet.collector" Version="6.0.0"/>
        <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.8.0"/>
        <PackageReference Include="xunit" Version="2.5.3"/>
        <PackageReference Include="xunit.runner.visualstudio" Version="2.5.3"/>
    </ItemGroup>

    <ItemGroup>
        <Using Include="Xunit"/>
    </ItemGroup>

    <!-- pyRevitLabs.Json is referenced Private=false by the Ini backend (not copied);
         deploy it here so the test host can load it at runtime. -->
    <ItemGroup>
        <Reference Include="pyRevitLabs.Json" HintPath="$(PyRevitDevLibsDir)\pyRevitLabs.Json.dll" Private="true"/>
    </ItemGroup>

    <ItemGroup>
        <None Include="Fixtures\*.ini" CopyToOutputDirectory="PreserveNewest"/>
    </ItemGroup>

    <ItemGroup>
      <ProjectReference Include="..\..\pyRevitLabs.Configurations.Ini\pyRevitLabs.Configurations.Ini.csproj" />
      <ProjectReference Include="..\..\pyRevitLabs.Configurations\pyRevitLabs.Configurations.csproj" />
    </ItemGroup>

</Project>
