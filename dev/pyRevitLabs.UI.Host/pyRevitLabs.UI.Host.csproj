<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>pyrevit-ui-host</AssemblyName>
    <RootNamespace>PyRevitLabs.UI.Host</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\pyRevitLabs.UI.Protocol\pyRevitLabs.UI.Protocol.csproj" />
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.3485.44" />
  </ItemGroup>
  <Target Name="DeployUiHost" AfterTargets="Build" Condition="'$(SkipPyRevitDeploy)' != 'true'">
    <PropertyGroup>
      <UiHostDeployDir>$(MSBuildThisFileDirectory)..\..\bin\ui-host</UiHostDeployDir>
    </PropertyGroup>
    <ItemGroup>
      <UiHostDeployFiles Include="$(TargetDir)**\*.*" />
    </ItemGroup>
    <MakeDir Directories="$(UiHostDeployDir)" />
    <Copy SourceFiles="@(UiHostDeployFiles)"
          DestinationFiles="@(UiHostDeployFiles->'$(UiHostDeployDir)\%(RecursiveDir)%(Filename)%(Extension)')"
          SkipUnchangedFiles="true" />
  </Target>
</Project>
