<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <SolidColorBrush x:Key="ShellBarBackground" Color="#F0F0F0" />
    <SolidColorBrush x:Key="ShellBarForeground" Color="#1E1E1E" />
    <SolidColorBrush x:Key="ShellSplitterBackground" Color="#E0E0E0" />
    <SolidColorBrush x:Key="ShellRunGlyph" Color="#3D9142" />
    <SolidColorBrush x:Key="ShellScrollTrack" Color="#F5F5F5" />
    <SolidColorBrush x:Key="ShellScrollThumb" Color="#C8C8C8" />
    <SolidColorBrush x:Key="ShellScrollThumbHover" Color="#A0A0A0" />
    <SolidColorBrush x:Key="ShellTitleBarBackground" Color="#F0F0F0" />
    <SolidColorBrush x:Key="ShellTitleBarForeground" Color="#1E1E1E" />
    <SolidColorBrush x:Key="ShellTitleBarButtonHover" Color="#D9D9D9" />
    <SolidColorBrush x:Key="ShellTitleBarButtonPressed" Color="#C8C8C8" />
    <SolidColorBrush x:Key="ShellTitleBarCloseHover" Color="#E81123" />
    <SolidColorBrush x:Key="ShellTitleBarClosePressed" Color="#F1707A" />
    <SolidColorBrush x:Key="ShellTitleBarCloseForeground" Color="#FFFFFF" />

    <!-- The scroll corner in stock ScrollViewer templates fills with the system control brush;
         overriding the key here keeps that corner in the shell palette. -->
    <SolidColorBrush x:Key="{x:Static SystemColors.ControlBrushKey}" Color="#F5F5F5" />

    <Style TargetType="{x:Type ToolBar}">
        <Setter Property="Band" Value="0" />
        <Setter Property="BandIndex" Value="0" />
        <Setter Property="Background" Value="{DynamicResource ShellBarBackground}" />
        <Setter Property="Foreground" Value="{DynamicResource ShellBarForeground}" />
    </Style>

    <!-- Segoe Fluent Icons on Win11, falling back to MDL2 on Win10; glyphs inherit the
         toolbar foreground so they follow the active theme without bitmap assets. -->
    <Style x:Key="ToolGlyph" TargetType="{x:Type TextBlock}">
        <Setter Property="FontFamily" Value="Segoe Fluent Icons, Segoe MDL2 Assets" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Margin" Value="0,0,4,0" />
    </Style>

    <Style x:Key="ToolLabel" TargetType="{x:Type TextBlock}">
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style x:Key="ToolButton" TargetType="{x:Type Button}"
           BasedOn="{StaticResource {x:Static ToolBar.ButtonStyleKey}}">
        <Setter Property="Padding" Value="6,3" />
        <Setter Property="Foreground" Value="{DynamicResource ShellBarForeground}" />
        <Style.Triggers>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.35" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="ToolCheckBox" TargetType="{x:Type CheckBox}"
           BasedOn="{StaticResource {x:Static ToolBar.CheckBoxStyleKey}}">
        <Setter Property="Padding" Value="4,3" />
        <Setter Property="Foreground" Value="{DynamicResource ShellBarForeground}" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>

    <Style x:Key="ShellScrollPageButton" TargetType="{x:Type RepeatButton}">
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type RepeatButton}">
                    <Rectangle Fill="Transparent" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="ShellScrollThumbStyle" TargetType="{x:Type Thumb}">
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Thumb}">
                    <Border x:Name="ThumbBorder"
                            Background="{DynamicResource ShellScrollThumb}"
                            CornerRadius="3"
                            Margin="3" />
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="ThumbBorder" Property="Background"
                                    Value="{DynamicResource ShellScrollThumbHover}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Flat arrow-less scrollbars so the editor and console read as one dark (or light)
         surface instead of showing the stock system chrome. -->
    <Style TargetType="{x:Type ScrollBar}">
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="Background" Value="{DynamicResource ShellScrollTrack}" />
        <Setter Property="Width" Value="14" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ScrollBar}">
                    <Border Background="{TemplateBinding Background}">
                        <Track x:Name="PART_Track" IsDirectionReversed="True">
                            <Track.DecreaseRepeatButton>
                                <RepeatButton Style="{StaticResource ShellScrollPageButton}"
                                              Command="ScrollBar.PageUpCommand" />
                            </Track.DecreaseRepeatButton>
                            <Track.Thumb>
                                <Thumb Style="{StaticResource ShellScrollThumbStyle}" />
                            </Track.Thumb>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton Style="{StaticResource ShellScrollPageButton}"
                                              Command="ScrollBar.PageDownCommand" />
                            </Track.IncreaseRepeatButton>
                        </Track>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="Orientation" Value="Horizontal">
                <Setter Property="Width" Value="Auto" />
                <Setter Property="Height" Value="14" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type ScrollBar}">
                            <Border Background="{TemplateBinding Background}">
                                <Track x:Name="PART_Track">
                                    <Track.DecreaseRepeatButton>
                                        <RepeatButton Style="{StaticResource ShellScrollPageButton}"
                                                      Command="ScrollBar.PageLeftCommand" />
                                    </Track.DecreaseRepeatButton>
                                    <Track.Thumb>
                                        <Thumb Style="{StaticResource ShellScrollThumbStyle}" />
                                    </Track.Thumb>
                                    <Track.IncreaseRepeatButton>
                                        <RepeatButton Style="{StaticResource ShellScrollPageButton}"
                                                      Command="ScrollBar.PageRightCommand" />
                                    </Track.IncreaseRepeatButton>
                                </Track>
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="ShellTitleBarButton" TargetType="{x:Type Button}">
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource ShellTitleBarForeground}" />
        <Setter Property="Width" Value="46" />
        <Setter Property="FontFamily" Value="Segoe Fluent Icons, Segoe MDL2 Assets" />
        <Setter Property="FontSize" Value="10" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Button}">
                    <Border x:Name="ButtonBorder" Background="{TemplateBinding Background}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="ButtonBorder" Property="Background"
                                    Value="{DynamicResource ShellTitleBarButtonHover}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="ButtonBorder" Property="Background"
                                    Value="{DynamicResource ShellTitleBarButtonPressed}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="ShellTitleBarCloseButton" TargetType="{x:Type Button}"
           BasedOn="{StaticResource ShellTitleBarButton}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Button}">
                    <Border x:Name="ButtonBorder" Background="{TemplateBinding Background}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="ButtonBorder" Property="Background"
                                    Value="{DynamicResource ShellTitleBarCloseHover}" />
                            <Setter Property="Foreground"
                                    Value="{DynamicResource ShellTitleBarCloseForeground}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="ButtonBorder" Property="Background"
                                    Value="{DynamicResource ShellTitleBarClosePressed}" />
                            <Setter Property="Foreground"
                                    Value="{DynamicResource ShellTitleBarCloseForeground}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
