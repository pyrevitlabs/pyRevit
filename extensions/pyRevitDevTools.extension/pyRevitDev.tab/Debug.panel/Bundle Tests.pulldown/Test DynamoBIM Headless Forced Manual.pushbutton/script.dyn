      "ConcreteType": "PythonNodeModels.PythonNode, PythonNodeModels",
      "Code": "import os\nfrom datetime import datetime\n\nfolder = r\"C:\\Temp\"\nif not os.path.exists(folder):\n    os.makedirs(folder)\n\nmarker_path = os.path.join(\n    folder,\n    \"Dynamo_Forced_Manual_SHOULD_NOT_RUN_{}.txt\".format(\n        datetime.now().strftime(\"%Y-%m-%d_%H-%M-%S\")\n    ),\n)\n\nwith open(marker_path, \"w\") as f:\n    f.write(\n        \"This graph is saved on Automatic run but the bundle forces it to Manual. A headless \"\n        \"automation run from pyRevit must report it as not run and never execute it.\"\n    )\n\nOUT = marker_path",
