<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Reactive Binding"
        Width="350" ResizeMode="NoResize" SizeToContent="Height"
        WindowStartupLocation="CenterScreen">
    <StackPanel Margin="10">
        <Label Content="Type a name, the greeting follows as you type" Margin="0,0,0,10" />
        <TextBox Text="{Binding name, UpdateSourceTrigger=PropertyChanged}"
                 Height="46" FontSize="18" VerticalContentAlignment="Center" Padding="10,0,10,0"/>
        <TextBlock Text="{Binding name, StringFormat='Hello {0}!'}"
                   FontSize="18" FontWeight="Heavy" TextWrapping="Wrap" Margin="0,10,0,0"/>
        <Button Content="Reset Name" Height="40" Margin="0,10,0,0" Click="reset_name" />
    </StackPanel>
</Window>
