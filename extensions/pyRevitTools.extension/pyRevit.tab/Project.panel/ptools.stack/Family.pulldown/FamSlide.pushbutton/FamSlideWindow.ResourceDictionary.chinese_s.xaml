<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:system="clr-namespace:System;assembly=mscorlib">
    <system:String x:Key="BtnRefresh">⟲ 刷新文档</system:String>
    <system:String x:Key="TooltipRefresh">重新扫描当前族文档，检测新增或删除的参数。切换到其他已打开的族后也很有用。</system:String>
    <system:String x:Key="TooltipShuffle">打乱参数值。在当前滑块范围内为每个可编辑参数随机赋值。请谨慎使用 - 此操作无法在 FamSlide 中撤销。</system:String>
    <system:String x:Key="TooltipDeleteUnused">删除所有未使用的参数。移除未驱动任何标注、未用于公式且非内置的族参数。请谨慎使用。</system:String>
    <system:String x:Key="TooltipToggleEditable">显示/隐藏可编辑参数。切换可通过滑块或复选框直接修改的参数的可见性。</system:String>
    <system:String x:Key="TooltipToggleLabels">显示/隐藏标签。切换每个参数名称下方小标签的显示。</system:String>
    <system:String x:Key="BtnClose">关闭</system:String>
    <system:String x:Key="TooltipClose">关闭 FamSlide</system:String>
    <system:String x:Key="GroupTitleValue">值参数</system:String>
    <system:String x:Key="GroupTitleBuiltin">内置参数</system:String>
    <system:String x:Key="GroupTitleYesNo">是/否参数</system:String>
    <system:String x:Key="TagInUse">使用中</system:String>
    <system:String x:Key="TagUsedInFormula">uF</system:String>
    <system:String x:Key="TagHasFormula">dF</system:String>
    <system:String x:Key="TagBuiltIn">内置</system:String>
    <system:String x:Key="TagInstance">实例</system:String>
    <system:String x:Key="TagType">类型</system:String>
    <system:String x:Key="TagAssociated">已关联</system:String>
    <system:String x:Key="NoFamilyLoaded">（未加载族）</system:String>
    <system:String x:Key="NoFamilyDocument">当前没有活动的族文档</system:String>
    <system:String x:Key="ValueYes">是</system:String>
    <system:String x:Key="ValueNo">否</system:String>
    <system:String x:Key="ConfirmShuffleMessage">是否将所有可编辑参数在当前滑块范围内随机打乱？

此操作无法在 FamSlide 中撤销 - 如需撤销请使用 Revit 自带的撤销功能。</system:String>
    <system:String x:Key="ConfirmDeleteUnusedMessage">是否删除所有未驱动标注、未用于公式且非内置的族参数？

此操作无法在 FamSlide 中撤销 - 如需撤销请使用 Revit 自带的撤销功能。</system:String>
    <system:String x:Key="AlertNoActiveDocument">没有活动的 Revit 文档。</system:String>
    <system:String x:Key="AlertFamilyEditorOnly">FamSlide 仅在族编辑器中可用。
请打开一个族进行编辑，然后重新运行此工具。</system:String>
</ResourceDictionary>
