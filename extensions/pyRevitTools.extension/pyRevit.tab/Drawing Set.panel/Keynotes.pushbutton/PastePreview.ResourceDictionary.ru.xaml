<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:system="clr-namespace:System;assembly=mscorlib">
    <system:String x:Key="Title">Вставка ключевых пометок</system:String>
    <system:String x:Key="TakeAllFromSource">Взять всё из источника</system:String>
    <system:String x:Key="OnlyNew">Только новые</system:String>
    <system:String x:Key="TakeNone">Ничего</system:String>
    <system:String x:Key="ColKey">Ключ</system:String>
    <system:String x:Key="ColSource">Из источника</system:String>
    <system:String x:Key="ColTarget">Сейчас в приёмнике</system:String>
    <system:String x:Key="ColResult">Результат</system:String>
    <system:String x:Key="PasteAction">Вставить</system:String>
    <system:String x:Key="CancelAction">Отмена</system:String>
    <system:String x:Key="HeaderInto">{0} запис(ей) из «{1}» в «{2}».</system:String>
    <system:String x:Key="HeaderNote">Отмеченные строки будут записаны в целевой файл ключевых пометок; остальное останется без изменений.</system:String>
    <system:String x:Key="FooterNote">Принятие конфликтной строки заменяет только ТЕКСТ — её место в дереве сохраняется.</system:String>
    <system:String x:Key="SummaryCounts">{0} добавить · {1} заменить · {2} без изменений</system:String>
    <system:String x:Key="GroupTag">(группа)</system:String>
    <system:String x:Key="ResultAdd">Добавить</system:String>
    <system:String x:Key="ResultReplace">Заменить текст</system:String>
    <system:String x:Key="ResultIdentical">Уже есть</system:String>
    <system:String x:Key="ResultLocked">Заблокировано: {0}</system:String>
    <system:String x:Key="ResultNoParent">Нет родительской группы</system:String>
    <system:String x:Key="UnknownSource">другого проекта</system:String>
    <system:String x:Key="SameFileNote">(тот же файл ключевых пометок)</system:String>
    <system:String x:Key="UnknownUser">другой пользователь</system:String>
</ResourceDictionary>
