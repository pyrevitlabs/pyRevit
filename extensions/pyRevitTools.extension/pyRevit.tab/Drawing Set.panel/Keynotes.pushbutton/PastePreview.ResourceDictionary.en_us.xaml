<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:system="clr-namespace:System;assembly=mscorlib">
    <system:String x:Key="Title">Paste Keynotes</system:String>
    <system:String x:Key="TakeAllFromSource">Take all from source</system:String>
    <system:String x:Key="OnlyNew">Only new</system:String>
    <system:String x:Key="TakeNone">None</system:String>
    <system:String x:Key="ColKey">Key</system:String>
    <system:String x:Key="ColSource">From source</system:String>
    <system:String x:Key="ColTarget">Currently in target</system:String>
    <system:String x:Key="ColResult">Result</system:String>
    <system:String x:Key="PasteAction">Paste</system:String>
    <system:String x:Key="CancelAction">Cancel</system:String>
    <system:String x:Key="HeaderInto">{0} record(s) from “{1}” into “{2}”.</system:String>
    <system:String x:Key="HeaderNote">Ticked rows are written to the target keynote file; everything else is left exactly as it is.</system:String>
    <system:String x:Key="FooterNote">Taking a conflicting row replaces the target's TEXT only — its place in the tree is kept.</system:String>
    <system:String x:Key="SummaryCounts">{0} to add · {1} to replace · {2} left alone</system:String>
    <system:String x:Key="GroupTag">(group)</system:String>
    <system:String x:Key="ResultAdd">Add</system:String>
    <system:String x:Key="ResultReplace">Replace text</system:String>
    <system:String x:Key="ResultIdentical">Already there</system:String>
    <system:String x:Key="ResultLocked">Locked by {0}</system:String>
    <system:String x:Key="ResultNoParent">No parent group</system:String>
    <system:String x:Key="UnknownSource">another project</system:String>
    <system:String x:Key="SameFileNote">(same keynote file)</system:String>
    <system:String x:Key="UnknownUser">another user</system:String>
</ResourceDictionary>
