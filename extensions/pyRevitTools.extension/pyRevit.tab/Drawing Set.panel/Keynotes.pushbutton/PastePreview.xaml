<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        ShowInTaskbar="False"
        Width="760" Height="560"
        MinWidth="620" MinHeight="420"
        ResizeMode="CanResizeWithGrip"
        Title="{DynamicResource Title}"
        WindowStartupLocation="CenterOwner">
    <Window.Resources>
        <SolidColorBrush x:Key="RowBorderBrush" Color="#22808080"/>
        <SolidColorBrush x:Key="ConflictBrush" Color="#D9822B"/>
        <SolidColorBrush x:Key="NewBrush" Color="#2E9E5B"/>
        <SolidColorBrush x:Key="MutedBrush" Color="#80808080"/>

        <Style x:Key="ColHeader" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground"
                    Value="{DynamicResource pyRevitSubtleForegroundBrush}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
        </Style>

        <Style x:Key="BarButton" TargetType="Button">
            <Setter Property="Padding" Value="10,3"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
            <Setter Property="FontSize" Value="11"/>
        </Style>
    </Window.Resources>

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- WHERE FROM / WHERE TO (composed in PastePreviewWindow.__init__) -->
        <TextBlock x:Name="headerText" Grid.Row="0"
                   TextWrapping="Wrap" Margin="0,0,0,8"
                   Foreground="{DynamicResource pyRevitWindowForegroundBrush}"/>

        <!-- BULK ACTIONS -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,8">
            <Button x:Name="takeAllBtn" Content="{DynamicResource TakeAllFromSource}"
                    Style="{StaticResource BarButton}" Click="take_all"/>
            <Button x:Name="onlyNewBtn" Content="{DynamicResource OnlyNew}"
                    Style="{StaticResource BarButton}" Click="only_new"/>
            <Button x:Name="takeNoneBtn" Content="{DynamicResource TakeNone}"
                    Style="{StaticResource BarButton}" Click="take_none"/>
            <TextBlock x:Name="summaryText" VerticalAlignment="Center"
                       Margin="8,0,0,0" FontSize="11"
                       Foreground="{DynamicResource pyRevitSubtleForegroundBrush}"/>
        </StackPanel>

        <!-- COLUMN HEADERS -->
        <Grid Grid.Row="2" Margin="6,0,6,4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="26"/>
                <ColumnDefinition Width="150"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="120"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="1" Text="{DynamicResource ColKey}"
                       Style="{StaticResource ColHeader}"/>
            <TextBlock Grid.Column="2" Text="{DynamicResource ColSource}"
                       Style="{StaticResource ColHeader}"/>
            <TextBlock Grid.Column="3" Text="{DynamicResource ColTarget}"
                       Style="{StaticResource ColHeader}"/>
            <TextBlock Grid.Column="4" Text="{DynamicResource ColResult}"
                       Style="{StaticResource ColHeader}"/>
        </Grid>

        <!-- ROWS (built in code: see PastePreviewWindow._make_row) -->
        <Border Grid.Row="3" BorderThickness="1"
                BorderBrush="{DynamicResource pyRevitControlBorderBrush}"
                Background="{DynamicResource pyRevitControlBackgroundBrush}">
            <ScrollViewer VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <ItemsControl x:Name="rowsPanel" Margin="2"/>
            </ScrollViewer>
        </Border>

        <!-- FOOTER -->
        <Grid Grid.Row="4" Margin="0,10,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="footerNote" Grid.Column="0" TextWrapping="Wrap"
                       FontSize="11" VerticalAlignment="Center" Margin="0,0,12,0"
                       Foreground="{DynamicResource pyRevitSubtleForegroundBrush}"/>
            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button x:Name="pasteBtn" Content="{DynamicResource PasteAction}"
                        MinWidth="90" Padding="10,4" Margin="0,0,6,0"
                        Click="do_paste"/>
                <Button x:Name="cancelBtn" Content="{DynamicResource CancelAction}"
                        MinWidth="90" Padding="10,4" Click="do_cancel"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
