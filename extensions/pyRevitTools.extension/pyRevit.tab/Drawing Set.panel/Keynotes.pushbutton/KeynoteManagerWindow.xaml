<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        ShowInTaskbar="True"
        Width="720" Height="750"
        MinWidth="720" MinHeight="480"
        ResizeMode="CanResizeWithGrip"
        WindowStartupLocation="Manual"
        Title="Keynote Manager"
        Closing="window_closing"
        KeyDown="window_keydown">

    <Window.Resources>
        <!-- ============================================================ -->
        <!-- COLOR PALETTE                                                -->
        <!-- ============================================================ -->
        <SolidColorBrush x:Key="AccentBrush"        Color="#2B579A"/>
        <SolidColorBrush x:Key="AccentHoverBrush"   Color="#3A6FB0"/>
        <SolidColorBrush x:Key="WarningBrush"       Color="#CA5010"/>
        <SolidColorBrush x:Key="DangerBrush"        Color="#E35054"/>
        <SolidColorBrush x:Key="LockedBgBrush"      Color="#FFF4CE"/>
        <SolidColorBrush x:Key="LockedFgBrush"      Color="#1E1E1E"/>
        <SolidColorBrush x:Key="UsedBadgeBgBrush"   Color="#E8F5E9"/>
        <SolidColorBrush x:Key="UsedBadgeFgBrush"   Color="#2E7D32"/>
        <!-- Category key badge. Must stay dark enough for its hardcoded white
             text AND stay visible against BOTH row surfaces: #FFFFFF (light)
             and pyRevitControlBackground #222933 (dark). #333333 was only
             1.16:1 against the dark row, so the badge vanished. -->
        <SolidColorBrush x:Key="CatBadgeBrush"      Color="#525E73"/>
        <SolidColorBrush x:Key="TypeElBgBrush"      Color="#E3F2FD"/>
        <SolidColorBrush x:Key="TypeElFgBrush"      Color="#1565C0"/>
        <SolidColorBrush x:Key="TypeMatBgBrush"     Color="#FFF3E0"/>
        <SolidColorBrush x:Key="TypeMatFgBrush"     Color="#E65100"/>
        <SolidColorBrush x:Key="TypeUsrBgBrush"     Color="#F3E5F5"/>
        <SolidColorBrush x:Key="TypeUsrFgBrush"     Color="#6A1B9A"/>

        <!-- Row selection colours.
             TreeItemContainer uses the STOCK TreeViewItem template, whose
             internal "Bd" border repaints the row from SYSTEM brushes when
             selected - and swaps to the INACTIVE variant (a light grey) the
             moment the tree loses focus, which is exactly what happens when
             the context menu opens. A Style setter cannot reach Bd, but these
             window-level key overrides do. Active and inactive are mapped to
             the SAME brush so the row does not change colour on right-click. -->
        <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}"
                         Color="{DynamicResource pyRevitSelectionBackgroundColor}"/>
        <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}"
                         Color="{DynamicResource pyRevitSelectionForegroundColor}"/>
        <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightBrushKey}"
                         Color="{DynamicResource pyRevitSelectionBackgroundColor}"/>
        <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightTextBrushKey}"
                         Color="{DynamicResource pyRevitSelectionForegroundColor}"/>

        <!-- ============================================================ -->
        <!-- BASE BUTTON STYLES                                           -->
        <!-- ============================================================ -->
        <Style x:Key="FlatButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="{DynamicResource pyRevitWindowForegroundBrush}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                CornerRadius="3"
                                Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background"
                                        Value="{DynamicResource pyRevitControlHoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background"
                                        Value="{DynamicResource pyRevitControlPressedBrush}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.35"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="AccentButton" TargetType="Button" BasedOn="{StaticResource FlatButton}">
            <Setter Property="Background" Value="{StaticResource AccentBrush}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                CornerRadius="3"
                                Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background"
                                        Value="{StaticResource AccentHoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ToolbarButton" TargetType="Button" BasedOn="{StaticResource FlatButton}">
            <Setter Property="Width" Value="30"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="ToolTipService.InitialShowDelay" Value="300"/>
        </Style>

        <Style x:Key="ToolbarSep" TargetType="Rectangle">
            <Setter Property="Width" Value="1"/>
            <Setter Property="Height" Value="20"/>
            <Setter Property="Fill" Value="{DynamicResource pyRevitControlBorderBrush}"/>
            <Setter Property="Margin" Value="4,0"/>
        </Style>

        <Style x:Key="SearchBox" TargetType="TextBox">
            <Setter Property="Height" Value="30"/>
            <Setter Property="Padding" Value="28,0,28,0"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="BorderBrush" Value="{DynamicResource pyRevitControlBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Background" Value="{DynamicResource pyRevitControlBackgroundBrush}"/>
        </Style>

        <!-- ============================================================ -->
        <!-- TREEVIEW ITEM CONTAINER                                      -->
        <!-- ============================================================ -->
        <Style x:Key="TreeItemContainer" TargetType="TreeViewItem">
            <Setter Property="IsExpanded" Value="True"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="0"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="AllowDrop" Value="True"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding locked}" Value="True">
                    <Setter Property="Background" Value="{StaticResource LockedBgBrush}"/>
                    <Setter Property="Foreground" Value="{StaticResource LockedFgBrush}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding used}" Value="True">
                    <Setter Property="FontWeight" Value="Medium"/>
                </DataTrigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="{DynamicResource pyRevitSelectionBackgroundBrush}"/>
                    <Setter Property="Foreground" Value="{DynamicResource pyRevitSelectionForegroundBrush}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- ============================================================ -->
        <!-- CONTEXT MENUS                                                -->
        <!-- WPF's default ContextMenu/MenuItem templates paint a light
             icon gutter that no Background setter can reach, so it stayed
             white in dark mode. pyRevit ships no menu theming, so both
             controls are retemplated here. These are IMPLICIT styles so
             they also cover the unstyled `caseMenu` further down.
             NOTE: no submenu (Popup) support - this window has no nested
             MenuItems. Add the submenu parts if that ever changes. -->
        <Style TargetType="ContextMenu">
            <Setter Property="Background" Value="{DynamicResource pyRevitControlBackgroundBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource pyRevitWindowForegroundBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource pyRevitControlBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ContextMenu">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="3" Padding="0,4"
                                SnapsToDevicePixels="True">
                            <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Cycle"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="MenuItem">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource pyRevitWindowForegroundBrush}"/>
            <Setter Property="Padding" Value="12,5"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="MenuItem">
                        <Border x:Name="bg"
                                Background="{TemplateBinding Background}"
                                Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <!-- Foreground is inherited from the MenuItem, so an
                                     element-level Foreground (the red Delete) flows
                                     through untouched. -->
                                <ContentPresenter x:Name="hdr" Grid.Column="0"
                                                  ContentSource="Header"
                                                  VerticalAlignment="Center"
                                                  RecognizesAccessKey="True"/>
                                <TextBlock x:Name="gesture" Grid.Column="1"
                                           Text="{TemplateBinding InputGestureText}"
                                           Margin="28,0,0,0"
                                           VerticalAlignment="Center"
                                           Foreground="{DynamicResource pyRevitSubtleForegroundBrush}"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <!-- Collapse (not just blank) the gesture column, or its
                                 margin is still measured for items with no shortcut. -->
                            <Trigger Property="InputGestureText" Value="">
                                <Setter TargetName="gesture" Property="Visibility" Value="Collapsed"/>
                            </Trigger>
                            <!-- Repaint the text too: the Delete item carries a local red
                                 Foreground, which is unreadable on the selection fill. -->
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="bg" Property="Background"
                                        Value="{DynamicResource pyRevitSelectionBackgroundBrush}"/>
                                <Setter TargetName="hdr" Property="TextElement.Foreground"
                                        Value="{DynamicResource pyRevitSelectionForegroundBrush}"/>
                                <Setter TargetName="gesture" Property="Foreground"
                                        Value="{DynamicResource pyRevitSelectionForegroundBrush}"/>
                            </Trigger>
                            <!-- Target the presenter, not the MenuItem: an element-level
                                 Foreground outranks a template trigger, so disabling the
                                 red Delete would otherwise leave it looking enabled. -->
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="hdr" Property="TextElement.Foreground"
                                        Value="{DynamicResource pyRevitDisabledForegroundBrush}"/>
                                <Setter TargetName="gesture" Property="Foreground"
                                        Value="{DynamicResource pyRevitDisabledForegroundBrush}"/>
                            </Trigger>
                            <!-- A disabled item still reports IsHighlighted on hover, so
                                 without this it would light up as if it were clickable.
                                 Declared last: for the same target+property, last wins. -->
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsHighlighted" Value="True"/>
                                    <Condition Property="IsEnabled" Value="False"/>
                                </MultiTrigger.Conditions>
                                <Setter TargetName="bg" Property="Background" Value="Transparent"/>
                                <Setter TargetName="hdr" Property="TextElement.Foreground"
                                        Value="{DynamicResource pyRevitDisabledForegroundBrush}"/>
                            </MultiTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Menu separators only; toolbar dividers use ToolbarSep (Rectangle).
             MUST be keyed with MenuItem.SeparatorStyleKey: MenuItem.PrepareMenuItem
             force-repoints a menu Separator's Style via SetResourceReference to that
             key whenever the current style came from an implicit reference, so an
             unkeyed TargetType="Separator" style is silently discarded and the OS
             theme's light, gutter-indented rule is used instead. -->
        <Style x:Key="{x:Static MenuItem.SeparatorStyleKey}" TargetType="Separator">
            <Setter Property="Background" Value="{DynamicResource pyRevitControlBorderBrush}"/>
            <Setter Property="Margin" Value="8,4"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Separator">
                        <Rectangle Height="1" Fill="{TemplateBinding Background}"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CtxMenuItem" TargetType="MenuItem"
               BasedOn="{StaticResource {x:Type MenuItem}}"/>

        <Style x:Key="CtxKeynoteMenuItem" TargetType="MenuItem"
               BasedOn="{StaticResource CtxMenuItem}">
            <Setter Property="IsEnabled" Value="False"/>
            <Style.Triggers>
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding is_category}" Value="False"/>
                        <Condition Binding="{Binding locked}" Value="False"/>
                    </MultiDataTrigger.Conditions>
                    <Setter Property="IsEnabled" Value="True"/>
                </MultiDataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="CtxNotLockedMenuItem" TargetType="MenuItem"
               BasedOn="{StaticResource CtxMenuItem}">
            <Setter Property="IsEnabled" Value="True"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding locked}" Value="True">
                    <Setter Property="IsEnabled" Value="False"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>


        <HierarchicalDataTemplate x:Key="KeynoteTreeItem"
                                  ItemsSource="{Binding children}">

            <Border x:Name="itemBorder" Padding="4,4" Margin="0,0,16,0"
                    CornerRadius="3"
                    Background="Transparent"
                    AllowDrop="True"
                    HorizontalAlignment="Stretch"
                    MaxWidth="{Binding ActualWidth,
                                       RelativeSource={RelativeSource AncestorType=TreeViewItem},
                                       Mode=OneWay}"
                    DragOver="tree_item_drag_over"
                    DragLeave="tree_item_drag_leave"
                    Drop="tree_item_drop"
                    PreviewMouseRightButtonDown="tree_item_right_click">

                <Border.ContextMenu>
                    <ContextMenu DataContext="{Binding PlacementTarget.DataContext,
                                                       RelativeSource={RelativeSource Self}}">
                        <MenuItem Header="Add Keynote" InputGestureText="Ctrl+N"
                                  Style="{StaticResource CtxMenuItem}"
                                  Click="add_keynote"/>
                        <Separator/>
                        <MenuItem Header="Place User Keynote"
                                  Style="{StaticResource CtxKeynoteMenuItem}"
                                  Click="place_user_keynote"/>
                        <MenuItem Header="Place Element Keynote"
                                  Style="{StaticResource CtxKeynoteMenuItem}"
                                  Click="place_element_keynote"/>
                        <MenuItem Header="Place Material Keynote"
                                  Style="{StaticResource CtxKeynoteMenuItem}"
                                  Click="place_material_keynote"/>
                        <Separator/>
                        <MenuItem Header="Edit" InputGestureText="F2"
                                  Style="{StaticResource CtxNotLockedMenuItem}"
                                  Click="edit_keynote"/>
                        <MenuItem Header="Duplicate" InputGestureText="Ctrl+D"
                                  Style="{StaticResource CtxKeynoteMenuItem}"
                                  Click="duplicate_keynote"/>
                        <MenuItem Header="Change Key"
                                  Style="{StaticResource CtxNotLockedMenuItem}"
                                  Click="rekey_keynote"/>
                        <MenuItem Header="Find in Model"
                                  Style="{StaticResource CtxKeynoteMenuItem}"
                                  Click="show_keynote"/>
                        <Separator/>
                        <MenuItem Header="Delete" InputGestureText="Del"
                                  Foreground="{StaticResource DangerBrush}"
                                  Style="{StaticResource CtxNotLockedMenuItem}"
                                  Click="remove_keynote"/>
                    </ContextMenu>
                </Border.ContextMenu>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- KEY BADGE -->
                    <Border x:Name="keyBadge" Grid.Column="0"
                            Background="{StaticResource AccentBrush}"
                            CornerRadius="2" Padding="6,1,6,2"
                            VerticalAlignment="Center"
                            Margin="0,0,8,0"
                            MinWidth="36" MaxWidth="140">
                        <TextBlock Text="{Binding key}"
                                   Foreground="White" FontSize="11"
                                   FontWeight="SemiBold"
                                   HorizontalAlignment="Center"
                                   TextTrimming="CharacterEllipsis"/>
                    </Border>

                    <!-- KEYNOTE TEXT -->
                    <TextBlock x:Name="textDisplay" Grid.Column="1"
                               Text="{Binding text}"
                               Foreground="{DynamicResource pyRevitWindowForegroundBrush}"
                               FontSize="13"
                               VerticalAlignment="Center"
                               TextWrapping="Wrap"/>

                    <!-- STATUS BADGES -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal"
                                VerticalAlignment="Center" Margin="8,0,0,0">
                        <!-- Child count -->
                        <Border x:Name="childCountBadge" Visibility="Collapsed"
                                Background="{DynamicResource pyRevitControlHoverBrush}"
                                CornerRadius="8" Padding="5,1,5,2"
                                Margin="0,0,4,0">
                            <TextBlock Foreground="{DynamicResource pyRevitSubtleForegroundBrush}"
                                       FontSize="10" FontWeight="SemiBold">
                                <TextBlock.Text>
                                    <MultiBinding StringFormat="{}{0} items">
                                        <Binding Path="children.Count"/>
                                    </MultiBinding>
                                </TextBlock.Text>
                            </TextBlock>
                        </Border>
                        <!-- Used count -->
                        <Border x:Name="usedBadge" Visibility="Collapsed"
                                Background="{StaticResource UsedBadgeBgBrush}"
                                CornerRadius="8" Padding="5,1,5,2"
                                Margin="0,0,4,0"
                                ToolTip="{Binding tooltip}">
                            <TextBlock Foreground="{StaticResource UsedBadgeFgBrush}"
                                       FontSize="10" FontWeight="SemiBold">
                                <TextBlock.Text>
                                    <MultiBinding StringFormat="{}{0}x">
                                        <Binding Path="used_count"/>
                                    </MultiBinding>
                                </TextBlock.Text>
                            </TextBlock>
                        </Border>
                        <!-- Type: Element -->
                        <Border x:Name="typElBadge" Visibility="Collapsed"
                                Background="{StaticResource TypeElBgBrush}"
                                CornerRadius="8" Padding="5,1,5,2"
                                Margin="0,0,2,0">
                            <TextBlock Text="Element"
                                       Foreground="{StaticResource TypeElFgBrush}"
                                       FontSize="9" FontWeight="SemiBold"/>
                        </Border>
                        <!-- Type: Material -->
                        <Border x:Name="typMatBadge" Visibility="Collapsed"
                                Background="{StaticResource TypeMatBgBrush}"
                                CornerRadius="8" Padding="5,1,5,2"
                                Margin="0,0,2,0">
                            <TextBlock Text="Material"
                                       Foreground="{StaticResource TypeMatFgBrush}"
                                       FontSize="9" FontWeight="SemiBold"/>
                        </Border>
                        <!-- Type: User -->
                        <Border x:Name="typUsrBadge" Visibility="Collapsed"
                                Background="{StaticResource TypeUsrBgBrush}"
                                CornerRadius="8" Padding="5,1,5,2"
                                Margin="0,0,4,0">
                            <TextBlock Text="User"
                                       Foreground="{StaticResource TypeUsrFgBrush}"
                                       FontSize="9" FontWeight="SemiBold"/>
                        </Border>
                        <!-- Lock badge -->
                        <Border x:Name="lockBadge" Visibility="Collapsed"
                                Background="{StaticResource WarningBrush}"
                                CornerRadius="8" Padding="6,1,6,2">
                            <TextBlock Foreground="White" FontFamily="Segoe UI Symbol"
                                       FontSize="10" FontWeight="SemiBold">
                                <TextBlock.Text>
                                    <MultiBinding StringFormat="&#x1F512; {0}">
                                        <Binding Path="owner"/>
                                    </MultiBinding>
                                </TextBlock.Text>
                            </TextBlock>
                        </Border>
                    </StackPanel>
                </Grid>
            </Border>

            <HierarchicalDataTemplate.Triggers>
                <DataTrigger Binding="{Binding is_category}" Value="True">
                    <Setter TargetName="keyBadge"    Property="Background" Value="{StaticResource CatBadgeBrush}"/>
                    <Setter TargetName="textDisplay"  Property="FontWeight" Value="SemiBold"/>
                    <Setter TargetName="textDisplay"  Property="FontSize"   Value="14"/>
                    <Setter TargetName="itemBorder"   Property="Margin"     Value="0,4,0,2"/>
                    <Setter TargetName="childCountBadge" Property="Visibility" Value="Visible"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding used}" Value="True">
                    <Setter TargetName="usedBadge" Property="Visibility" Value="Visible"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding locked}" Value="True">
                    <Setter TargetName="lockBadge"  Property="Visibility" Value="Visible"/>
                    <Setter TargetName="textDisplay" Property="Foreground"
                            Value="{DynamicResource pyRevitDisabledForegroundBrush}"/>
                </DataTrigger>
                <!-- A locked row that is ALSO selected must keep the selection
                     foreground; the locked setter above would otherwise leave
                     low-contrast disabled-grey text on the selection fill. -->
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding locked}" Value="True"/>
                        <Condition Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=TreeViewItem}}" Value="True"/>
                    </MultiDataTrigger.Conditions>
                    <Setter TargetName="textDisplay" Property="Foreground"
                            Value="{DynamicResource pyRevitSelectionForegroundBrush}"/>
                </MultiDataTrigger>
                <DataTrigger Binding="{Binding has_element_type}" Value="True">
                    <Setter TargetName="typElBadge" Property="Visibility" Value="Visible"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding has_material_type}" Value="True">
                    <Setter TargetName="typMatBadge" Property="Visibility" Value="Visible"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding has_user_type}" Value="True">
                    <Setter TargetName="typUsrBadge" Property="Visibility" Value="Visible"/>
                </DataTrigger>
            </HierarchicalDataTemplate.Triggers>
        </HierarchicalDataTemplate>

    </Window.Resources>

    <!-- ================================================================ -->
    <!-- MAIN LAYOUT                                                      -->
    <!-- ================================================================ -->
    <Grid Background="{DynamicResource pyRevitChromeBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ROW 0 — FILE TOOLBAR -->
        <Border Grid.Row="0"
                Background="{DynamicResource pyRevitControlBackgroundBrush}"
                BorderBrush="{DynamicResource pyRevitControlBorderBrush}"
                BorderThickness="0,0,0,1" Padding="8,4">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button Style="{StaticResource FlatButton}"
                            Content="Import" ToolTip="Import from .txt (Ctrl+I)"
                            Click="import_keynotes"/>
                    <Button Style="{StaticResource FlatButton}"
                            Content="Export All" Click="export_keynotes"/>
                    <Button Style="{StaticResource FlatButton}"
                            Content="Export Visible" Click="export_visible_keynotes"/>
                    <Rectangle Style="{StaticResource ToolbarSep}"/>
                    <Button Style="{StaticResource FlatButton}"
                            Content="Change File" Click="change_keynote_file"/>
                    <Button Style="{StaticResource ToolbarButton}"
                            Content="&#x1F4C2;" FontSize="14" FontFamily="Segoe UI Symbol"
                            ToolTip="Show in Explorer" Click="show_keynote_file"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal">
                    <Button Style="{StaticResource FlatButton}"
                            Content="&#x21BB; Refresh" ToolTip="F5" Click="refresh"/>
                    <Rectangle Style="{StaticResource ToolbarSep}"/>
                    <Button Style="{StaticResource AccentButton}"
                            Content="Update Model" Padding="14,4"
                            Click="update_model"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- ROW 1 — SEARCH + TREE TOOLBAR -->
        <Border Grid.Row="1"
                Background="{DynamicResource pyRevitControlBackgroundBrush}"
                BorderBrush="{DynamicResource pyRevitControlBorderBrush}"
                BorderThickness="0,0,0,1" Padding="8,5">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Search -->
                <DockPanel Grid.Row="0">
                    <Button DockPanel.Dock="Right"
                            Style="{StaticResource FlatButton}"
                            Content="&#x25BC; Filters" Margin="6,0,0,0"
                            Click="custom_filter"/>
                    <Grid>
                        <TextBox x:Name="search_tb" Style="{StaticResource SearchBox}"
                                 TextChanged="search_txt_changed"/>
                        <TextBlock Text="&#x1F50D;  Search keynotes..." FontFamily="Segoe UI Symbol"
                                   FontSize="12" IsHitTestVisible="False"
                                   VerticalAlignment="Center" HorizontalAlignment="Left"
                                   Margin="8,0,0,0"
                                   Foreground="{DynamicResource pyRevitDisabledForegroundBrush}">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Text, ElementName=search_tb}" Value="">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <Button x:Name="clrsearch_b" Visibility="Collapsed"
                                Style="{StaticResource FlatButton}"
                                HorizontalAlignment="Right" Width="24" Height="24"
                                Content="&#x2715;" FontSize="10"
                                Foreground="{DynamicResource pyRevitDisabledForegroundBrush}"
                                Click="clear_search"/>
                    </Grid>
                </DockPanel>

                <!-- Action toolbar -->
                <DockPanel Grid.Row="1" Margin="0,5,0,0">
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Margin="10,0,0,0">
                        <TextBlock Text="Place:" VerticalAlignment="Center"
                                   FontSize="11" Margin="0,0,6,0"
                                   Foreground="{DynamicResource pyRevitSubtleForegroundBrush}"/>
                        <RadioButton x:Name="userknote_rb" Content="User"
                                     VerticalAlignment="Center" Margin="0,0,8,0" FontSize="11"/>
                        <RadioButton x:Name="elementknote_rb" Content="Element"
                                     VerticalAlignment="Center" Margin="0,0,8,0" FontSize="11"/>
                        <RadioButton x:Name="materialknote_rb" Content="Material"
                                     VerticalAlignment="Center" FontSize="11"/>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal">
                        <Button x:Name="expandAllBtn" Style="{StaticResource ToolbarButton}" Width="28"
                                ToolTip="Expand all" Click="expand_all_tree">
                            <TextBlock Text="&#x229E;" FontSize="14" FontFamily="Segoe UI Symbol"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Button>
                        <Button x:Name="collapseAllBtn" Style="{StaticResource ToolbarButton}" Width="28"
                                ToolTip="Collapse all" Click="collapse_all_tree">
                            <TextBlock Text="&#x229F;" FontSize="14" FontFamily="Segoe UI Symbol"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Button>

                        <Rectangle Style="{StaticResource ToolbarSep}"/>

                        <!-- Add Group / Keynote -->
                        <Button x:Name="addCategoryBtn" Style="{StaticResource ToolbarButton}"
                                ToolTip="Add group (top-level category)" Click="add_category">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="+" FontSize="14" FontWeight="Bold" VerticalAlignment="Center"/>
                                <TextBlock Text="Grp" FontSize="9" Margin="2,0,0,0"
                                           VerticalAlignment="Center" FontWeight="SemiBold"
                                           Foreground="{DynamicResource pyRevitSubtleForegroundBrush}"/>
                            </StackPanel>
                        </Button>
                        <Button x:Name="addKeynoteBtn" Style="{StaticResource ToolbarButton}"
                                ToolTip="Add keynote (Ctrl+N)" Click="add_keynote">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="+" FontSize="14" FontWeight="Bold" VerticalAlignment="Center"/>
                                <TextBlock Text="Key" FontSize="9" Margin="2,0,0,0"
                                           VerticalAlignment="Center" FontWeight="SemiBold"
                                           Foreground="{DynamicResource pyRevitSubtleForegroundBrush}"/>
                            </StackPanel>
                        </Button>

                        <Rectangle Style="{StaticResource ToolbarSep}"/>

                        <!-- HIERARCHY: Indent / Outdent / Move Up / Move Down -->
                        <Button x:Name="indentBtn" Style="{StaticResource ToolbarButton}" Width="34"
                                ToolTip="Indent — make child of sibling above (Tab)"
                                IsEnabled="False" Click="indent_keynote">
                            <TextBlock Text="&#x21E5;" FontSize="16" FontWeight="Bold"
                                       Foreground="{DynamicResource pyRevitWindowForegroundBrush}"/>
                        </Button>
                        <Button x:Name="outdentBtn" Style="{StaticResource ToolbarButton}" Width="34"
                                ToolTip="Outdent — promote up one level (Shift+Tab)"
                                IsEnabled="False" Click="outdent_keynote">
                            <TextBlock Text="&#x21E4;" FontSize="16" FontWeight="Bold"
                                       Foreground="{DynamicResource pyRevitWindowForegroundBrush}"/>
                        </Button>
                        <Button x:Name="moveUpBtn" Style="{StaticResource ToolbarButton}" Width="28"
                                ToolTip="Move up (Ctrl+Up)" IsEnabled="False" Click="move_up">
                            <TextBlock Text="&#x25B2;" FontSize="10"
                                       Foreground="{DynamicResource pyRevitSubtleForegroundBrush}"/>
                        </Button>
                        <Button x:Name="moveDownBtn" Style="{StaticResource ToolbarButton}" Width="28"
                                ToolTip="Move down (Ctrl+Down)" IsEnabled="False" Click="move_down">
                            <TextBlock Text="&#x25BC;" FontSize="10"
                                       Foreground="{DynamicResource pyRevitSubtleForegroundBrush}"/>
                        </Button>

                        <Rectangle Style="{StaticResource ToolbarSep}"/>

                        <!-- Edit / Duplicate / Re-Key -->
                        <Button x:Name="editKeynoteBtn" Style="{StaticResource ToolbarButton}"
                                Content="&#x270E;" FontSize="13"
                                ToolTip="Edit (F2)" IsEnabled="False" Click="edit_keynote"/>
                        <Button x:Name="dupKeynoteBtn" Style="{StaticResource ToolbarButton}"
                                Content="&#x2750;" FontSize="13"
                                ToolTip="Duplicate (Ctrl+D)" IsEnabled="False" Click="duplicate_keynote"/>
                        <Button x:Name="rekeyBtn" Style="{StaticResource ToolbarButton}"
                                Content="&#x1F511;" FontSize="12" FontFamily="Segoe UI Symbol"
                                ToolTip="Change key" IsEnabled="False" Click="rekey_keynote"/>

                        <Rectangle Style="{StaticResource ToolbarSep}"/>

                        <!-- Capitalization -->
                        <Button x:Name="caseBtn" Style="{StaticResource ToolbarButton}"
                                Width="36" ToolTip="Change text capitalization"
                                IsEnabled="False" Click="show_case_menu">
                            <TextBlock Text="Aa" FontSize="12" FontWeight="SemiBold"
                                       Foreground="{DynamicResource pyRevitSubtleForegroundBrush}"/>
                            <Button.ContextMenu>
                                <ContextMenu x:Name="caseMenu">
                                    <MenuItem Header="UPPER CASE"   Click="to_upper"    InputGestureText="TT"/>
                                    <MenuItem Header="lower case"   Click="to_lower"    InputGestureText="tt"/>
                                    <MenuItem Header="Title Case"   Click="to_title"    InputGestureText="Tt"/>
                                    <MenuItem Header="Sentence case" Click="to_sentence" InputGestureText="Se"/>
                                </ContextMenu>
                            </Button.ContextMenu>
                        </Button>

                        <Rectangle Style="{StaticResource ToolbarSep}"/>

                        <!-- Delete -->
                        <Button x:Name="removeBtn" Style="{StaticResource ToolbarButton}"
                                Content="&#x2715;" FontSize="12"
                                Foreground="{StaticResource DangerBrush}"
                                ToolTip="Delete (Del)" IsEnabled="False" Click="remove_keynote"/>

                        <Rectangle Style="{StaticResource ToolbarSep}"/>

                        <!-- Find / Place -->
                        <Button x:Name="findBtn" Style="{StaticResource ToolbarButton}"
                                Content="&#x1F50D;" FontSize="12" FontFamily="Segoe UI Symbol"
                                ToolTip="Find in model" IsEnabled="False" Click="show_keynote"/>
                        <Button x:Name="placeBtn" Style="{StaticResource ToolbarButton}"
                                Content="&#x1F4CC;" FontSize="12" FontFamily="Segoe UI Symbol"
                                ToolTip="Place in model (or Shift+Click a keynote)"
                                IsEnabled="False" Click="place_keynote"/>
                    </StackPanel>
                </DockPanel>
            </Grid>
        </Border>

        <!-- ROW 2 — THE TREE -->
        <Grid Grid.Row="2" Background="{DynamicResource pyRevitControlBackgroundBrush}">
            <TextBlock x:Name="emptyStateMsg"
                       Text="No keynotes loaded. Add a group to get started."
                       HorizontalAlignment="Center" VerticalAlignment="Center"
                       FontSize="14" Foreground="{DynamicResource pyRevitDisabledForegroundBrush}"
                       Visibility="Collapsed"/>

            <TreeView x:Name="keynotes_tv"
                      BorderThickness="0" Background="Transparent" Padding="6,4"
                      ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                      VirtualizingPanel.IsVirtualizing="True"
                      VirtualizingPanel.VirtualizationMode="Recycling"
                      ItemTemplate="{StaticResource KeynoteTreeItem}"
                      ItemContainerStyle="{StaticResource TreeItemContainer}"
                      SelectedItemChanged="selected_keynote_changed"
                      PreviewMouseLeftButtonDown="tree_preview_mouse_down"
                      PreviewMouseLeftButtonUp="tree_preview_mouse_up"
                      PreviewMouseMove="tree_preview_mouse_move"
                      PreviewMouseDoubleClick="tree_double_click"
                      AllowDrop="True"
                      DragOver="tree_drag_over"
                      Drop="tree_drop"/>
        </Grid>

        <!-- ROW 3 — STATUS BAR -->
        <Border Grid.Row="3" Background="{StaticResource AccentBrush}" Padding="10,4">
            <DockPanel>
                <TextBlock x:Name="statusRight" DockPanel.Dock="Right"
                           Foreground="White" FontSize="11" Opacity="0.8"/>
                <TextBlock x:Name="statusLeft"
                           Foreground="White" FontSize="11" Opacity="0.9"
                           TextTrimming="CharacterEllipsis"/>
            </DockPanel>
        </Border>
    </Grid>
</Window>
