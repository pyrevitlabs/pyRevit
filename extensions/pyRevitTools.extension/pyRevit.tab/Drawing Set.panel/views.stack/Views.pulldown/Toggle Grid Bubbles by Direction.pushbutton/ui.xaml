<Window
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="{DynamicResource Title}"
    Background="{DynamicResource pyRevitWindowBackgroundBrush}"
    MinWidth="380"
    SizeToContent="Height"
    Width="420"
    ResizeMode="NoResize"
    ShowInTaskbar="False">

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <GroupBox Grid.Row="0" Header="{DynamicResource OperationScopeHeader}" Margin="0,0,0,12"
                  FontWeight="SemiBold" Foreground="{DynamicResource pyRevitWindowForegroundBrush}">
            <StackPanel Margin="12">
                <StackPanel Orientation="Horizontal">
                    <TextBlock x:Name="status_grids" Text="" FontSize="12" Margin="0,5,0,5" Foreground="{DynamicResource pyRevitWindowForegroundBrush}"/>
                    <TextBlock x:Name="status_grids_active" Text="" FontSize="12" Margin="0,5,0,5" Foreground="{DynamicResource pyRevitDangerForegroundBrush}" FontWeight="Bold"/>
                </StackPanel>
                <TextBlock x:Name="status_coordinate_system" Text="" FontSize="12" Margin="0,5" Foreground="{DynamicResource pyRevitWindowForegroundBrush}"/>
                <TextBlock x:Name="status_active_controls" Text="" FontSize="12" Margin="0,5" Foreground="{DynamicResource pyRevitDangerForegroundBrush}" FontWeight="Bold"/>
            </StackPanel>
        </GroupBox>

        <GroupBox Grid.Row="1" Header="{DynamicResource ToggleAllHeader}" Margin="0,0,0,12"
                  FontWeight="SemiBold" Foreground="{DynamicResource pyRevitWindowForegroundBrush}">
            <Grid Margin="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <RadioButton x:Name="show_all" Grid.Column="0" GroupName="ToggleAll" Content="{DynamicResource ShowAll}"
                             Margin="10" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="12"/>
                <RadioButton x:Name="hide_all" Grid.Column="1" GroupName="ToggleAll" Content="{DynamicResource HideAll}"
                             Margin="10" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="12"/>
            </Grid>
        </GroupBox>

        <GroupBox Grid.Row="2" Header="{DynamicResource ToggleByDirectionHeader}" Margin="0,0,0,12"
                  FontWeight="SemiBold" Foreground="{DynamicResource pyRevitWindowForegroundBrush}">
            <Grid Margin="12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <CheckBox x:Name="check_top" Grid.Row="0" Grid.Column="1" Content="{DynamicResource Top}"
                          HorizontalAlignment="Center" VerticalAlignment="Center"
                          Margin="0,8,0,8" FontSize="12"/>
                <CheckBox x:Name="check_left" Grid.Row="1" Grid.Column="0" Content="{DynamicResource Left}"
                          HorizontalAlignment="Center" VerticalAlignment="Center"
                          Margin="0,8,0,8" FontSize="12"/>
                <CheckBox x:Name="check_right" Grid.Row="1" Grid.Column="2" Content="{DynamicResource Right}"
                          HorizontalAlignment="Center" VerticalAlignment="Center"
                          Margin="0,8,0,8" FontSize="12"/>
                <CheckBox x:Name="check_bottom" Grid.Row="2" Grid.Column="1" Content="{DynamicResource Bottom}"
                          HorizontalAlignment="Center" VerticalAlignment="Center"
                          Margin="0,8,0,8" FontSize="12"/>
            </Grid>
        </GroupBox>

        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Button x:Name="back_button" Grid.Column="0" Click="go_back"
                    HorizontalAlignment="Stretch" VerticalAlignment="Center"
                    Height="32" Margin="0,0,6,0" Content="{DynamicResource Back}"/>

            <Button Grid.Column="1" Content="{DynamicResource Cancel}" Click="cancel"
                    HorizontalAlignment="Stretch" VerticalAlignment="Center"
                    Height="32" Margin="6,0" />

            <Button Grid.Column="2" Content="{DynamicResource OK}" Click="confirm"
                    HorizontalAlignment="Stretch" VerticalAlignment="Center"
                    Height="32" Margin="6,0,0,0" IsDefault="True"/>
        </Grid>
    </Grid>
</Window>
