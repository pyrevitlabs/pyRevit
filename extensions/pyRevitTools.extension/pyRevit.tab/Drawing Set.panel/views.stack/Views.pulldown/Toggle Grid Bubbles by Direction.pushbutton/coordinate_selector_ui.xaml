<Window
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="{DynamicResource Title}"
    Background="{DynamicResource pyRevitWindowBackgroundBrush}"
    MinWidth="380"
    SizeToContent="Height"
    Width="420"
    ResizeMode="NoResize"
    ShowInTaskbar="False">

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="{DynamicResource Subtitle}"
                   FontSize="12" HorizontalAlignment="Center" Margin="0,10,0,10"
                   Foreground="{DynamicResource pyRevitSubtleForegroundBrush}"/>

        <GroupBox Grid.Row="1" Header="{DynamicResource CoordinateSystemHeader}" Margin="0,0,0,12"
                  FontWeight="SemiBold" Foreground="{DynamicResource pyRevitWindowForegroundBrush}">
            <StackPanel Margin="12,5,12,0">
                <RadioButton x:Name="all_grids" GroupName="CoordSystem" Content="{DynamicResource AllGrids}"
                             Margin="0,8,0,5" FontWeight="Normal" FontSize="12"/>
                <TextBlock Text="{DynamicResource AllGridsDescription}"
                           FontSize="10" Foreground="{DynamicResource pyRevitSubtleForegroundBrush}" Margin="20,0,0,8"/>

                <RadioButton x:Name="radio_true_north" GroupName="CoordSystem" Content="{DynamicResource TrueNorth}"
                             Margin="0,5,0,5" FontWeight="Normal" FontSize="12"/>
                <TextBlock Text="{DynamicResource TrueNorthDescription}"
                           FontSize="10" Foreground="{DynamicResource pyRevitSubtleForegroundBrush}" Margin="20,0,0,8"/>

                <RadioButton x:Name="radio_project_north" GroupName="CoordSystem" Content="{DynamicResource ProjectNorth}"
                             Margin="0,8,0,5" FontWeight="Normal" FontSize="12"/>
                <TextBlock Text="{DynamicResource ProjectNorthDescription}"
                           FontSize="10" Foreground="{DynamicResource pyRevitSubtleForegroundBrush}" Margin="20,0,0,8"/>

                <RadioButton x:Name="radio_view_orientation" GroupName="CoordSystem" Content="{DynamicResource ViewOrientation}"
                             Margin="0,5,0,5" FontWeight="Normal" FontSize="12"/>
                <TextBlock Text="{DynamicResource ViewOrientationDescription}"
                           FontSize="10" Foreground="{DynamicResource pyRevitSubtleForegroundBrush}" Margin="20,0,0,8"/>
            </StackPanel>
        </GroupBox>

        <GroupBox Grid.Row="2" Header="{DynamicResource AngleToleranceHeader}" Margin="0,0,0,12"
                  FontWeight="SemiBold" Foreground="{DynamicResource pyRevitWindowForegroundBrush}">
            <StackPanel Margin="12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Slider x:Name="angle_slider" Grid.Column="0" Minimum="1" Maximum="40"
                            Value="10" TickFrequency="1" IsSnapToTickEnabled="True"
                            Margin="0,8,15,8" ValueChanged="angle_slider_changed"/>

                    <TextBlock x:Name="angle_display" Grid.Column="1" Text="10°"
                               FontSize="18" FontWeight="Bold" Foreground="{DynamicResource pyRevitWindowForegroundBrush}"
                               VerticalAlignment="Center" MinWidth="50"/>
                </Grid>

                <Grid Margin="0,5,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="{DynamicResource StrictLabel}" FontSize="10"
                               Foreground="{DynamicResource pyRevitSubtleForegroundBrush}" HorizontalAlignment="Left"/>
                    <TextBlock Grid.Column="1" Text="{DynamicResource PermissiveLabel}" FontSize="10"
                               Foreground="{DynamicResource pyRevitSubtleForegroundBrush}" HorizontalAlignment="Right"/>
                </Grid>

                <TextBlock x:Name="angle_description" Text="Moderate - good for most cases"
                           FontSize="12" Foreground="{DynamicResource pyRevitSubtleForegroundBrush}" HorizontalAlignment="Center"
                           Margin="0,5,0,10" FontStyle="Italic"/>

                <Border Background="{DynamicResource pyRevitSelectionBackgroundBrush}" BorderBrush="{DynamicResource pyRevitControlBorderBrush}" BorderThickness="1"
                        CornerRadius="5" Margin="0,5,0,0" Padding="12">
                    <StackPanel>
                        <TextBlock Text="{DynamicResource HowThisWorks}" FontSize="12" FontWeight="SemiBold"
                                   Foreground="{DynamicResource pyRevitSelectionForegroundBrush}" Margin="0,0,0,5"/>
                        <TextBlock Text="{DynamicResource HowThisWorksDescription}"
                                   FontSize="11" Foreground="{DynamicResource pyRevitSelectionForegroundBrush}" TextWrapping="Wrap" LineHeight="16"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </GroupBox>

        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Button Grid.Column="0" Content="{DynamicResource Cancel}" Click="cancel"
                    HorizontalAlignment="Stretch" VerticalAlignment="Center"
                    Height="32" Margin="0,0,6,0"/>

            <Button Grid.Column="1" Content="{DynamicResource Continue}" Click="proceed"
                    HorizontalAlignment="Stretch" VerticalAlignment="Center"
                    Height="32" Margin="6,0,0,0" IsDefault="True"/>
        </Grid>
    </Grid>
</Window>
