<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:system="clr-namespace:System;assembly=mscorlib">

    <system:String x:Key="Msg_NoViewsWithFilters">No hay vistas ni plantillas de vista con filtros asignados.
Agregue un filtro a una vista e inténtelo de nuevo.</system:String>
    <system:String x:Key="Label_Template">Plantilla</system:String>

    <system:String x:Key="SelectViews_Title">Seleccionar vistas / plantillas</system:String>
    <system:String x:Key="SelectViews_Button">Continuar</system:String>

    <system:String x:Key="Msg_NoTextTypes">No se encontraron tipos de nota de texto en el proyecto.</system:String>

    <system:String x:Key="Settings_Title">Ajustes de leyenda de filtros</system:String>
    <system:String x:Key="Settings_Section_Layout">Texto y diseño</system:String>
    <system:String x:Key="Settings_TextType">Tipo de nota de texto</system:String>
    <system:String x:Key="Settings_RowHeight">Alto de fila ({0})</system:String>
    <system:String x:Key="Settings_RowSpacing">Espaciado de filas ({0})</system:String>
    <system:String x:Key="Settings_SwatchWidth">Ancho de la muestra ({0})</system:String>
    <system:String x:Key="Settings_ColumnWidth">Ancho de columna de texto ({0})</system:String>
    <system:String x:Key="Settings_Section_Behavior">Comportamiento</system:String>
    <system:String x:Key="Settings_SortAlpha">Ordenar filtros alfabéticamente</system:String>
    <system:String x:Key="Settings_OpenLegend">Abrir la última leyenda creada</system:String>

    <system:String x:Key="Header_FilterName">Nombre del filtro</system:String>
    <system:String x:Key="Header_Parameter">Parámetro</system:String>
    <system:String x:Key="Header_Value">Valor</system:String>
    <system:String x:Key="Value_NA">N/D</system:String>

    <system:String x:Key="Msg_Done">Se crearon {0} vista(s) de leyenda.</system:String>
    <system:String x:Key="Msg_Failed">No se pudo crear ninguna vista de leyenda. Consulte el registro para más detalles.</system:String>

</ResourceDictionary>
