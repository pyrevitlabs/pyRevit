<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:system="clr-namespace:System;assembly=mscorlib">

    <system:String x:Key="Msg_NoViewsWithFilters">没有已指定过滤器的视图或视图样板。
请先为视图添加过滤器，然后重试。</system:String>
    <system:String x:Key="Label_Template">样板</system:String>

    <system:String x:Key="SelectViews_Title">选择视图 / 样板</system:String>
    <system:String x:Key="SelectViews_Button">继续</system:String>

    <system:String x:Key="Msg_NoTextTypes">项目中未找到任何文字注释类型。</system:String>

    <system:String x:Key="Settings_Title">过滤器图例设置</system:String>
    <system:String x:Key="Settings_Section_Layout">文字与布局</system:String>
    <system:String x:Key="Settings_TextType">文字注释类型</system:String>
    <system:String x:Key="Settings_RowHeight">行高 ({0})</system:String>
    <system:String x:Key="Settings_RowSpacing">行间距 ({0})</system:String>
    <system:String x:Key="Settings_SwatchWidth">色块宽度 ({0})</system:String>
    <system:String x:Key="Settings_ColumnWidth">文字列宽 ({0})</system:String>
    <system:String x:Key="Settings_Section_Behavior">行为</system:String>
    <system:String x:Key="Settings_SortAlpha">按字母顺序排序过滤器</system:String>
    <system:String x:Key="Settings_OpenLegend">打开最近创建的图例</system:String>

    <system:String x:Key="Header_FilterName">过滤器名称</system:String>
    <system:String x:Key="Header_Parameter">参数</system:String>
    <system:String x:Key="Header_Value">值</system:String>
    <system:String x:Key="Value_NA">不适用</system:String>

    <system:String x:Key="Msg_Done">已创建 {0} 个图例视图。</system:String>
    <system:String x:Key="Msg_Failed">未能创建任何图例视图，请查看日志了解详情。</system:String>

</ResourceDictionary>
