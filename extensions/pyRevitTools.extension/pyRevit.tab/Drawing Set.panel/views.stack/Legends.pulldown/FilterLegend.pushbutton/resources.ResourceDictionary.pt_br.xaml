<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:system="clr-namespace:System;assembly=mscorlib">

    <system:String x:Key="Msg_NoViewsWithFilters">Não há vistas ou modelos de vista com filtros atribuídos.
Adicione um filtro a uma vista e tente novamente.</system:String>
    <system:String x:Key="Label_Template">Modelo</system:String>

    <system:String x:Key="SelectViews_Title">Selecionar vistas / modelos</system:String>
    <system:String x:Key="SelectViews_Button">Continuar</system:String>

    <system:String x:Key="Msg_NoTextTypes">Nenhum tipo de nota de texto encontrado no projeto.</system:String>

    <system:String x:Key="Settings_Title">Configurações da legenda de filtros</system:String>
    <system:String x:Key="Settings_Section_Layout">Texto e layout</system:String>
    <system:String x:Key="Settings_TextType">Tipo de nota de texto</system:String>
    <system:String x:Key="Settings_RowHeight">Altura da linha ({0})</system:String>
    <system:String x:Key="Settings_RowSpacing">Espaçamento entre linhas ({0})</system:String>
    <system:String x:Key="Settings_SwatchWidth">Largura da amostra ({0})</system:String>
    <system:String x:Key="Settings_ColumnWidth">Largura da coluna de texto ({0})</system:String>
    <system:String x:Key="Settings_Section_Behavior">Comportamento</system:String>
    <system:String x:Key="Settings_SortAlpha">Ordenar filtros alfabeticamente</system:String>
    <system:String x:Key="Settings_OpenLegend">Abrir a última legenda criada</system:String>

    <system:String x:Key="Header_FilterName">Nome do filtro</system:String>
    <system:String x:Key="Header_Parameter">Parâmetro</system:String>
    <system:String x:Key="Header_Value">Valor</system:String>
    <system:String x:Key="Value_NA">N/D</system:String>

    <system:String x:Key="Msg_Done">{0} vista(s) de legenda criada(s).</system:String>
    <system:String x:Key="Msg_Failed">Não foi possível criar nenhuma vista de legenda. Verifique o log para mais detalhes.</system:String>

</ResourceDictionary>
