<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:system="clr-namespace:System;assembly=mscorlib">

    <system:String x:Key="Msg_NoViewsWithFilters">There are no views or view templates with filters assigned.
Please add a filter to a view and try again.</system:String>
    <system:String x:Key="Label_Template">Template</system:String>

    <system:String x:Key="SelectViews_Title">Select Views / Templates</system:String>
    <system:String x:Key="SelectViews_Button">Continue</system:String>

    <system:String x:Key="Msg_NoTextTypes">No Text Note Types found in the project.</system:String>

    <system:String x:Key="Settings_Title">Filter Legend Settings</system:String>
    <system:String x:Key="Settings_Section_Layout">Text &amp; Layout</system:String>
    <system:String x:Key="Settings_TextType">Text Note Type</system:String>
    <system:String x:Key="Settings_RowHeight">Row Height ({0})</system:String>
    <system:String x:Key="Settings_RowSpacing">Row Spacing ({0})</system:String>
    <system:String x:Key="Settings_SwatchWidth">Swatch Width ({0})</system:String>
    <system:String x:Key="Settings_ColumnWidth">Text Column Width ({0})</system:String>
    <system:String x:Key="Settings_Section_Behavior">Behavior</system:String>
