<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <sys:String x:Key="no_filters">Este projeto não tem filtros de vista.</sys:String>
    <sys:String x:Key="no_valid_filters">Os filtros selecionados não têm regras a aplicar.</sys:String>
    <sys:String x:Key="select_title">Selecionar filtros de vista</sys:String>
    <sys:String x:Key="select_button">Selecionar</sys:String>
    <sys:String x:Key="nothing_found">Nenhum elemento correspondente foi encontrado.</sys:String>
    <sys:String x:Key="config_title">Opções de seleção por filtro</sys:String>
    <sys:String x:Key="config_button">Salvar</sys:String>
    <sys:String x:Key="exclude_nested">Excluir instâncias de família aninhadas</sys:String>
    <sys:String x:Key="only_current_view">Pesquisar apenas na vista ativa</sys:String>
    <sys:String x:Key="reverse_filter">Selecionar os elementos que não correspondem</sys:String>
</ResourceDictionary>
