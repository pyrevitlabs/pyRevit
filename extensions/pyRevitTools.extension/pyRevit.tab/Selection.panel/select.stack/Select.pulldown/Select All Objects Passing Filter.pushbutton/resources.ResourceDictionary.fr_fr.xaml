<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <sys:String x:Key="no_filters">Ce projet ne contient aucun filtre de vue.</sys:String>
    <sys:String x:Key="no_valid_filters">Les filtres sélectionnés n'ont aucune règle à appliquer.</sys:String>
    <sys:String x:Key="select_title">Sélectionner les filtres de vue</sys:String>
    <sys:String x:Key="select_button">Sélectionner</sys:String>
    <sys:String x:Key="nothing_found">Aucun élément correspondant n'a été trouvé.</sys:String>
    <sys:String x:Key="config_title">Options de sélection par filtre</sys:String>
    <sys:String x:Key="config_button">Enregistrer</sys:String>
    <sys:String x:Key="exclude_nested">Exclure les instances de famille imbriquées</sys:String>
    <sys:String x:Key="only_current_view">Rechercher uniquement dans la vue active</sys:String>
    <sys:String x:Key="reverse_filter">Sélectionner les éléments qui ne correspondent pas</sys:String>
</ResourceDictionary>
