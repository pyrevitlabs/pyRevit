<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <sys:String x:Key="memory_empty">A memória de seleção deste documento está vazia.</sys:String>
    <sys:String x:Key="memory_stale">Nenhum dos elementos da memória de seleção existe mais neste documento.</sys:String>
    <sys:String x:Key="save_transaction">Salvar memória de seleção como filtro de seleção</sys:String>
    <sys:String x:Key="save_done">{0} elementos salvos como filtro de seleção "{1}".</sys:String>
    <sys:String x:Key="save_failed">O Revit rejeitou a alteração, então nenhum filtro de seleção foi salvo.</sys:String>
    <sys:String x:Key="purge_nothing">Não há arquivos de memória para remover.</sys:String>
    <sys:String x:Key="purge_done">{0} arquivos de memória removidos:</sys:String>
</ResourceDictionary>
