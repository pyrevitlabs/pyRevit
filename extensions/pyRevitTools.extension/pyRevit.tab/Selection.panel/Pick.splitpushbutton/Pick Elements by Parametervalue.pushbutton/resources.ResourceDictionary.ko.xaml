<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <sys:String x:Key="pick_element_prompt">매개변수를 선택할 요소를 선택하세요</sys:String>
    <sys:String x:Key="pick_rectangle_prompt">일치하는 매개변수 값을 가진 요소를 선택할 사각형을 그리세요</sys:String>
    <sys:String x:Key="no_readable_parameters">선택한 매개변수 중 요소 자체에서 읽을 수 있는 것이 없습니다. 유형 매개변수는 지원되지 않습니다. 선택된 항목이 없습니다.</sys:String>
    <sys:String x:Key="select_parameters_title">일치시킬 매개변수 선택</sys:String>
    <sys:String x:Key="select_parameters_button">선택</sys:String>
</ResourceDictionary>
