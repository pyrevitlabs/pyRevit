<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <sys:String x:Key="pick_element_prompt">Sélectionnez un élément pour choisir les paramètres</sys:String>
    <sys:String x:Key="pick_rectangle_prompt">Tracez un rectangle pour sélectionner les éléments dont les valeurs de paramètres correspondent</sys:String>
    <sys:String x:Key="no_readable_parameters">Aucun des paramètres sélectionnés ne peut être lu sur l'élément lui-même. Les paramètres de type ne sont pas pris en charge. Rien n'a été sélectionné.</sys:String>
    <sys:String x:Key="select_parameters_title">Sélectionner les paramètres à comparer</sys:String>
    <sys:String x:Key="select_parameters_button">Sélectionner</sys:String>
</ResourceDictionary>
