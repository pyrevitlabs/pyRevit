[[source]]
name = "pypi"
url = "https://pypi.org/simple"
verify_ssl = true

[dev-packages]
mypy = "*"
pylint = "==4.0.6"
pre-commit = "*"

[packages]
pyyaml = ">=5.4"
black = "*"
setuptools = "==84.0.0"
mkdocs = "*"
mkdocstrings = "*"
mkdocstrings-python = "*"
mkdocs-gen-files = "*"
mkdocs-literate-nav = "*"
mkdocs-exclude = "*"
mkdocs-section-index = "*"
mkdocs-material = "*"
ruff = "*"

[requires]
python_version = "3.14"

[pipenv]
allow_prereleases = false

[scripts]
docs = "mkdocs build"
check-docstrings = "ruff check --fix pyrevitlib/pyrevit"
check-py3 = "python ./dev/scripts/check_py3_compat.py"
install-hooks = "pre-commit install"
