[[source]]
name = "pypi"
url = "https://pypi.org/simple"
verify_ssl = true

[dev-packages]
pytest = "==9.0.2"
pytest-cov = "==7.0.0"
coverage = "==7.13.4"
mypy = "*"
pylint = "==4.0.9"
pre-commit = "*"

[packages]
pyyaml = ">=5.4"
black = "*"
setuptools = "==84.1.0"
mkdocs = "*"
mkdocstrings = "*"
mkdocstrings-python = "*"
mkdocs-gen-files = "*"
mkdocs-literate-nav = "*"
mkdocs-exclude = "*"
mkdocs-section-index = "*"
mkdocs-material = "*"
ruff = "*"

[requires]
python_version = "3.14"

[pipenv]
allow_prereleases = false

[scripts]
test = "python ./dev/tests/run_tests.py"
docs = "mkdocs build"
check-docstrings = "ruff check --fix pyrevitlib/pyrevit"
check-py3 = "python ./dev/checks/check_py3_compat.py"
test-py3-compat = "python -m pytest dev/tests/python/tooling/test_check_py3_compat.py"
check-config-api = "python ./dev/checks/check_config_api.py"
test-config-api = "python -m pytest dev/tests/python/tooling/test_check_config_api.py"
test-automation-markers = "python -m pytest dev/tests/python/library/test_automation_marker.py"
test-library = "python -m pytest dev/tests/python/library"
test-standalone = "python -m pytest dev/tests/python/library"
check-revit-api = "python ./dev/checks/check_revit_api_compat.py --baseline"
install-hooks = "pre-commit install"
